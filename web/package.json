{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:emu": "firebase emulators:exec --only firestore --project demo-goldenhour \"vitest run --config vitest.emu.config.ts\"",
    "test:e2e": "firebase emulators:exec --only auth,firestore --project demo-goldenhour \"node e2e/e2e.mjs\"",
    "check": "npm run lint && tsc -b && npm test && npm run test:emu && npm run build",
    "check:all": "npm run check && npm run test:e2e"
  },
  "dependencies": {
    "firebase": "^13.0.0",
    "leaflet": "^1.9.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "firebase-admin": "^14.5.0",
    "oxlint": "^1.81.0",
    "playwright-core": "^1.64.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  }
}
